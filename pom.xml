<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.vanillabp</groupId>
  <artifactId>hazelcast-shared-election-cache-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>VanillaBP shared election cache on Hazelcast</name>
  <description>An implementation of VanillaBP's WorkflowAdapterCache which lets the nodes of one application share their BPMS elections through an embedded Hazelcast cluster.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <modules>
    <module>core</module>
    <module>spring-boot</module>
    <module>quarkus</module>
    <module>test-coverage-report</module>
  </modules>

  <distributionManagement>
    <snapshotRepository>
      <id>github</id>
      <name>Github Packages</name>
      <url>https://maven.pkg.github.com/vanillabp/hazelcast-shared-election-cache</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <version.java>21</version.java>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- where the build breaks, in PERCENT of covered instructions per platform,
         enforced by test-coverage-report/coverage-gate. The rule stays 90 per platform, which is
         the number the coverage badges of the README are read against. The gate stands at
         85, the same number in every VanillaBP repository, because a threshold marks the
         point where somebody has to look and not the goal to aim at. It is never raised to whatever a
         suite happens to reach, and never lowered to make a build pass. -->
    <coverage.threshold.spring-boot>85</coverage.threshold.spring-boot>
    <coverage.threshold.quarkus>85</coverage.threshold.quarkus>
    <!-- the rule, as a number the gate can print: it reports every run against both, so
         the distance between a passing build and the rule is readable without opening
         the report -->
    <coverage.rule>90</coverage.rule>
    <lombok.version>1.18.46</lombok.version>
    <adapter-platform.version>2.0.0-SNAPSHOT</adapter-platform.version>
    <!-- the version members are compiled against, and therefore the version the cluster
         of an application's nodes speaks - see the compatibility table in README.md -->
    <hazelcast.version>5.7.0</hazelcast.version>
    <spring-boot.version>4.1.1</spring-boot.version>
    <quarkus.version>3.39.1</quarkus.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Platforms -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- the cache itself: an embedded member, not a client of a cluster somebody
           operates (see decision 1 in the repository's DECISIONS.md) -->
      <dependency>
        <groupId>com.hazelcast</groupId>
        <artifactId>hazelcast</artifactId>
        <version>${hazelcast.version}</version>
      </dependency>

      <!-- VanillaBP SPI + platform integrations -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-integration-spi</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-spring-boot-integration</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-quarkus-integration</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-quarkus-integration-deployment</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp.adapter</groupId>
        <artifactId>migration-adapter</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>test-utils</artifactId>
        <version>${adapter-platform.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- Own modules -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>hazelcast-shared-election-cache</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <optional>true</optional>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
          <configuration>
            <!-- '@{jacoco.agent}' is resolved lazily per module (late property binding),
                 forwarding coverage also into forked JVMs -->
            <argLine>@{jacoco.agent}</argLine>
            <!-- the classes of one module share a JVM, and Spring keeps every test context
                 until that JVM exits: what ran before is still running. A fixed order is
                 what makes the runner's result reproducible on a developer machine -->
            <runOrder>alphabetical</runOrder>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.6</version>
          <configuration>
            <argLine>@{jacoco.agent}</argLine>
            <runOrder>alphabetical</runOrder>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
          <configuration>
            <release>${version.java}</release>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <propertyName>jacoco.agent</propertyName>
          <excludes>
            <exclude>**/it/**</exclude>
            <exclude>**/test/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <sortPom>
              <quiet>true</quiet>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <flexmark/>
          </markdown>
          <yaml>
            <includes>
              <include>**/*.yaml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <jackson>
              <yamlFeatures>
                <MINIMIZE_QUOTES>true</MINIMIZE_QUOTES>
                <WRITE_DOC_START_MARKER>false</WRITE_DOC_START_MARKER>
                <INDENT_ARRAYS_WITH_INDICATOR>true</INDENT_ARRAYS_WITH_INDICATOR>
              </yamlFeatures>
            </jackson>
          </yaml>
          <java>
            <eclipse>
              <file>${maven.multiModuleProjectDirectory}/formatting_conventions.xml</file>
              <version>4.35</version>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,at.phactum</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
